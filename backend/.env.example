# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS configuration in production)
CLIENT_URL=http://localhost:5173

# Database Configuration (Use MongoDB Atlas connection string in production)
MONGODB_URI=mongodb://127.0.0.1:27017/vendor_management

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h

# Cloudinary File Storage (Production persistent asset storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# External Product Data Service (Optional)
RAPIDAPI_KEY=
RAPIDAPI_HOST=axesso-axesso-amazon-data-service-v1.p.rapidapi.com
AXESSO_BASE_URL=https://axesso-axesso-amazon-data-service-v1.p.rapidapi.com
